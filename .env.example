# Copie para .env e ajuste. O arquivo .env nunca deve ser versionado.
# Todas as variáveis da aplicação usam o prefixo ODB_.

# Ambiente lógico: dev | test
ODB_ENV=dev

# ---------------------------------------------------------------- PostgreSQL
# Superusuário do container (usado apenas pela inicialização do cluster).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=odb
# Porta publicada somente em 127.0.0.1.
POSTGRES_HOST_PORT=5432
# Pasta do host para `odb gold export` (crie antes: mkdir -p data/exports).
ODB_EXPORT_HOST_DIR=./data/exports

# API (perfil web). Porta publicada só em 127.0.0.1; origens do portal em JSON.
ODB_API_PORT=8000
ODB_API_CORS_ORIGINS=["http://localhost:3000"]
ODB_PORTAL_PORT=3000
# Links do cabeçalho e do rodapé do portal, embutidos no build (`docker compose build portal`).
# Sem valor, o link não aparece. Contato: página ou "mailto:" oficial do projeto.
NEXT_PUBLIC_CONTACT_URL=
NEXT_PUBLIC_REPO_URL=https://github.com/fredvasconcelos/OpenDataBrasil

# Senhas dos roles da aplicação (criados por infrastructure/postgres/init).
ODB_OWNER_PASSWORD=troque-owner
ODB_PIPELINE_PASSWORD=troque-pipeline
ODB_READER_PASSWORD=troque-reader

# ---------------------------------------------------------------- Lakehouse
# Raiz das camadas, vista de dentro dos containers.
ODB_LAKEHOUSE_ROOT_URI=file:///lakehouse
# Percentuais de uso de disco: alerta e bloqueio de novas escritas.
ODB_DISK_WARN_PERCENT=80
ODB_DISK_BLOCK_PERCENT=90

# ---------------------------------------------------------------- Processamento
POLARS_MAX_THREADS=8

# ---------------------------------------------------------------- DuckDB (consulta)
ODB_DUCKDB_MEMORY_LIMIT=4GB
ODB_DUCKDB_THREADS=4
ODB_DUCKDB_TEMP_DIRECTORY=/lakehouse/tmp/duckdb
ODB_DUCKDB_MAX_TEMP_DIRECTORY_SIZE=20GB

# ---------------------------------------------------------------- Limites dos containers
# Padrões dimensionados para a máquina de referência (16 threads). Reduza em máquinas menores:
# o Docker recusa um limite de CPUs maior que o número de CPUs disponíveis.
# ODB_WORKER_CPUS=8
# ODB_WORKER_MEMORY=24g
# ODB_TESTS_CPUS=4
# ODB_TESTS_MEMORY=6g
# ODB_POSTGRES_CPUS=2
# ODB_POSTGRES_MEMORY=2g
# ODB_DEV_CPUS=4
# ODB_DEV_MEMORY=8g

# ---------------------------------------------------------------- Logs
ODB_LOG_LEVEL=INFO

# dados.gov.br: chave de Consumidor, gerada em "Minha Conta" (login gov.br).
ODB_DADOSGOV_API_KEY=
