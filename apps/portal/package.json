{
  "name": "odb-portal",
  "version": "0.1.0",
  "private": true,
  "description": "Portal da Plataforma de Dados Abertos do Brasil (Next.js + d3), sobre a API da Gold publicada.",
  "license": "MIT",
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "gen:api": "openapi-typescript ../../tests/contracts/openapi.json -o src/lib/api-schema.ts"
  },
  "dependencies": {
    "d3-array": "3.2.4",
    "d3-format": "3.1.2",
    "d3-geo": "3.1.1",
    "d3-scale": "4.0.2",
    "d3-selection": "3.0.0",
    "d3-shape": "3.2.0",
    "d3-transition": "3.0.1",
    "d3-zoom": "3.0.0",
    "next": "16.4.3",
    "next-intl": "4.14.9",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/d3-array": "3.2.2",
    "@types/d3-format": "3.0.4",
    "@types/d3-geo": "3.1.1",
    "@types/d3-scale": "4.0.9",
    "@types/d3-selection": "3.0.12",
    "@types/d3-shape": "3.2.0",
    "@types/d3-transition": "3.0.9",
    "@types/d3-zoom": "3.0.9",
    "@types/geojson": "7946.0.16",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.13.0",
    "eslint-config-next": "16.4.3",
    "jsdom": "30.1.3",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
