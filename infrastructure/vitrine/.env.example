# Vitrine: variáveis do compose.yaml. O deploy.sh gera o .env real no servidor, com senhas
# aleatórias, na primeira implantação. Nunca versionar o .env.

# Tag das imagens enviadas pela Fábrica (deploy.sh usa homolog-<commit>).
ODB_IMAGE_TAG=homolog-0000000

# IP da interface onde o Caddy escuta; substitua o endereço de documentação abaixo.
ODB_LAN_IP=198.51.100.10

# Origens permitidas pela API (lista JSON).
ODB_API_CORS_ORIGINS=["http://198.51.100.10"]

# PostgreSQL (superusuário só para administração e restauração do catálogo).
POSTGRES_USER=odb_admin
POSTGRES_PASSWORD=troque
POSTGRES_DB=odb
ODB_OWNER_PASSWORD=troque
ODB_PIPELINE_PASSWORD=troque
ODB_READER_PASSWORD=troque
ODB_METRICS_WRITER_PASSWORD=troque
ODB_METRICS_READER_PASSWORD=troque

# Ajustes de capacidade (medir na V5 antes de mudar).
ODB_API_WORKERS=3
# Plano D, D2: ampliar só depois de medir D1. Exemplo com 3 réplicas:
# ODB_PORTAL_REPLICAS=3, ODB_PORTAL_CPUS=1.5, ODB_PORTAL_MEMORY=768m.
ODB_PORTAL_REPLICAS=1
ODB_PORTAL_CPUS=2
ODB_PORTAL_MEMORY=1g
# Requisições por minuto por visitante EM CADA WORKER (3 workers ≈ 600/min); 0 desliga
# (só em teste de carga).
ODB_API_RATE_LIMIT_PER_MINUTE=200
# Cache de respostas por release, por worker (MiB); 0 desliga.
ODB_API_RESPONSE_CACHE_MB=256
ODB_API_DUCKDB_MEMORY=1GB
ODB_LOG_LEVEL=INFO

# Grafana (V4): só acessível por túnel SSH em 127.0.0.1:3001.
GRAFANA_ADMIN_PASSWORD=troque
