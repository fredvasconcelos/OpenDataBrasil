# Normaliza finais de linha em LF no repositório (Windows/WSL2/Linux).
* text=auto eol=lf

# Scripts de shell e arquivos lidos dentro de containers Linux: sempre LF.
*.sh  text eol=lf
*.sql text eol=lf
Dockerfile text eol=lf

# Binários
*.png binary
*.jpg binary
*.zip binary
*.gz  binary
*.parquet binary

# Respostas reais de fontes: preservar os bytes exatos (sem normalizar finais de linha).
tests/fixtures/** -text
# Artefatos oficiais com SHA-256 registrado (snapshot do acervo, descritores SIDRA).
configs/catalog/sidra_acervo_*.csv -text
configs/catalog/descritores/** -text
